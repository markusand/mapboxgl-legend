{
  "compilerOptions": {
    "target": "es2019",
    "moduleResolution": "bundler",
    "paths": {
      "/@/*": ["./src/*"]
    },
    "declaration": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*.ts",
    "./vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
