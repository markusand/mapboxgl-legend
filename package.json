{
  "name": "mapboxgl-legend",
  "version": "1.16.0",
  "description": "Mapbox-GL plugin that automatically draws a legend from layer styles",
  "keywords": [
    "legend",
    "mapbox",
    "mapboxgl",
    "plugin",
    "style"
  ],
  "homepage": "https://github.com/markusand/mapboxgl-legend",
  "bugs": {
    "url": "https://github.com/markusand/mapboxgl-legend/issues"
  },
  "license": "ISC",
  "author": "Marc Vilella <mvilella@obsa.ad> (https://github.com/markusand)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markusand/mapboxgl-legend.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.es.js",
  "browser": "./dist/index.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.cjs"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "scripts": {
    "lint": "vp lint src && stylelint 'src/**/*.css'",
    "test": "vp test --coverage",
    "build": "vp test run && vp build",
    "prepare": "vp config && npm run build",
    "dev": "vp dev"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.0.1",
    "mapbox-gl": "^3.21.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  }
}
